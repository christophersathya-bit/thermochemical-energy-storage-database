/*--------------------------------*- C++ -*----------------------------------*\
  TCES packed-bed reactor - OpenFOAM v1912+ (ESI, openfoam.com)
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      U;
}

dimensions      [0 1 -1 0 0 0 0];
internalField   uniform (0.2 0 0);
boundaryField
{
    inlet        { type fixedValue; value uniform (0.2 0 0); }
    outlet       { type inletOutlet; inletValue uniform (0.2 0 0); value uniform (0.2 0 0); }
    wall         { type noSlip; }
    "(front|back)" { type wedge; }
    axis         { type empty; }
}

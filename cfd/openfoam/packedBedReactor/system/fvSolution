  TCES packed-bed reactor - OpenFOAM v1912+ (ESI, openfoam.com)
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSolution;
}

solvers
{
    p        { solver GAMG; tolerance 1e-8; relTol 0.05; smoother GaussSeidel; }
    "(U|h|e)" { solver smoothSolver; smoother GaussSeidel; tolerance 1e-8; relTol 0.1; }
}

SIMPLE
{
    nUCorrectors        2;
    nNonOrthogonalCorrectors 0;
    consistent          no;
    residualControl
    {
        p       1e-5;
        U       1e-6;
        "(h|e)" 1e-6;
    }
}

relaxationFactors
{
    fields      { p 0.3; rho 1; }
    equations   { U 0.7; "(h|e)" 0.7; }
}

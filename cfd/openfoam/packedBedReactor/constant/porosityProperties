FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      porosityProperties;
}

// Ergun-based Darcy-Forchheimer coefficients for the packed bed
// (generated by ../setup_from_1d.py: dp = 2 mm, eps = 0.40)
//   d = 150 (1-eps)^2 / (eps^3 dp^2),   f = 3.5 (1-eps) / (eps^3 dp)
porosity1
{
    type            DarcyForchheimer;
    active          yes;
    cellZone        bed;

    d   (2.109375e+08 2.109375e+08 2.109375e+08);
    f   (1.640625e+04 1.640625e+04 1.640625e+04);

    coordinateSystem
    {
        origin  (0 0 0);
        e1      (1 0 0);
        e2      (0 1 0);
    }
}
